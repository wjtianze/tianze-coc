# 复制为 .env 后按本机情况填写。
# MuMu 12 自带 adb：<MuMu 安装目录>\nx_device\12.0\shell\adb.exe
TZ_ADB=C:\Program Files\Netease\MuMu Player 12\nx_device\12.0\shell\adb.exe
TZ_DEVICE=127.0.0.1:16384
TZ_PACKAGE=com.atrasis.original

# 探针在模拟器内监听 127.0.0.1:TZ_PROBE_PORT，PC 侧通过 adb forward 映射到 TZ_HOST_PORT
TZ_PROBE_PORT=27650
TZ_HOST_PORT=27650

# 编译探针需要 Android NDK（r26 及以上）
TZ_NDK=C:\Android\ndk\26.3.11579264
# 重新签名 APK 需要 SDK build-tools（zipalign、apksigner）和 JDK 17
TZ_BUILD_TOOLS=C:\Android\build-tools\34.0.0
TZ_JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17

# 原版私服 APK（不随仓库分发）
TZ_ORIGINAL_APK=user-provided\atrasis.apk
